# Copy this file to ".env" and fill in your token. Never commit the real file.
#
# Get a free token: https://rechnungsapi.de/register  ->  Profile  ->  API token
RECHNUNGSAPI_TOKEN=

# --- Optional -----------------------------------------------------------------
# Where the demo listens. It has no login, so it binds to localhost by default.
# HOST=127.0.0.1
# PORT=3000

# Where invoices, customers and generated files are stored (plain JSON and files).
# DATA_DIR=./data

# Only needed when you reach the demo under another host name than localhost
# (for example behind a reverse proxy). Comma-separated, host names without port.
# ALLOWED_HOSTS=demo.example.com

# Point the SDK at a different gateway (staging, local mock).
# RECHNUNGSAPI_BASE_URL=https://api.rechnungsapi.de
# RECHNUNGSAPI_V2_BASE_URL=https://api.v2.rechnungsapi.de
